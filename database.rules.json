{
  "rules": {
    "users": {
      ".indexOn": ["uuid", "role"]
    },
    "products": {
      ".indexOn": ["category", "ecoRating", "price", "ratings"]
    },
    "categories": {
      ".indexOn": ["name"]
    },
    "orders": {
      ".indexOn": ["userId", "status"]
    },
    "carts": {
      ".indexOn": ["userId"]
    },
    "wishlists": {
      ".indexOn": ["userId"]
    },
    "recipes": {
      ".indexOn": ["ecoRating", "prepTime"]
    },
    "forumPosts": {
      ".indexOn": ["userId", "timestamp"]
    },
    "contacts": {
      ".indexOn": ["userId", "status", "timestamp"]
    },
    "challenges": {
      ".indexOn": ["startDate", "endDate", "participants", "isActive"]
    },
    "user_challenges": {
      ".indexOn": ["userId"]
    },
    "certifications": {
      ".indexOn": ["name"]
    },
    "energy_tips": {
      ".indexOn": ["category"]
    },
    "eco_travel": {
      ".indexOn": ["destination", "ecoRating"]
    },
    "educational_content": {
      ".indexOn": ["category", "difficulty", "isPublished"]
    },
    "waste_entries": {
      ".indexOn": ["userId", "date"]
    },
    "waste_goals": {
      ".indexOn": ["userId", "date"]
    },
    "carbon_footprint": {
      ".indexOn": ["userId", "date"]
    },
    "carbon_goals": {
      ".indexOn": ["userId"]
    },
    "user_progress": {
      ".indexOn": ["userId"]
    },
    "progress_goals": {
      ".indexOn": ["userId"]
    },
    ".read": true,
    ".write": true
  }
} 